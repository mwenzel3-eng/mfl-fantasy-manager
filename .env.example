# ---------------------------------------------------------------------------
# MyFantasyLeague credentials
# ---------------------------------------------------------------------------
# Find your league id in the league URL:
#   https://www44.myfantasyleague.com/2026/index?L=12345
#                                ^^^^^ this number
MFL_LEAGUE_ID=

# Season year. Almost always the current NFL season, not the calendar year.
MFL_YEAR=2026

# --- Authentication, pick ONE or BOTH -------------------------------------
#
# Option A (recommended for full access, including writes):
#   Your MFL login. MFL has no personal access token; you log in to obtain an
#   MFL_USER_ID cookie, and that cookie is required for every import request.
#   The password is never logged and is only ever sent to api.myfantasyleague.com
#   over HTTPS, via POST.
MFL_USERNAME=
MFL_PASSWORD=

# Option B (read-only):
#   Owner-level API key from any league: log in, then Help -> Developer's API.
#   Per MFL's documentation this works for export requests only, and cannot be
#   used for commissioner-level calls or for any import/write.
MFL_APIKEY=

# Optional: league host (wwwNN.myfantasyleague.com). Resolved automatically from
# the league export if omitted.
# MFL_HOST=www44.myfantasyleague.com

# Optional: only needed if you are a commissioner acting on another franchise,
# or if auto-detection fails.
# MFL_FRANCHISE_ID=0001

# ---------------------------------------------------------------------------
# Safety
# ---------------------------------------------------------------------------
# Writes are OFF unless BOTH of these are set. Keep them off until you have
# watched the recommendations for a few weeks and trust the output.
MFL_DRY_RUN=1
MFL_ENABLE_WRITES=0

# ---------------------------------------------------------------------------
# Tuning
# ---------------------------------------------------------------------------
# Seconds between API calls. MFL asks for at least one second and throttles
# aggressive clients with HTTP 429. Do not lower this.
MFL_REQUEST_DELAY=1.0

MFL_TIMEOUT=30

# MFL updates the player database at most once a day; caching it avoids
# hammering the API and is explicitly recommended by MFL. Set a directory to
# enable the on-disk cache (players only, at present).
MFL_CACHE_DIR=
MFL_CACHE_TTL=75600

MFL_LOG_LEVEL=INFO

# IANA timezone used for report timestamps. Arizona does not observe DST, so
# America/Phoenix is a fixed UTC-7 all year.
MFL_TIMEZONE=America/Phoenix

# ---------------------------------------------------------------------------
# Notifications (optional)
# ---------------------------------------------------------------------------
# log   - print the message (default, nothing to set up)
# none  - discard messages
# twilio- send real SMS
SMS_PROVIDER=log

# Required only when SMS_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SMS_TO=
